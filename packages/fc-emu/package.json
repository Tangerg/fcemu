{
  "name": "@fcemu/core",
  "version": "0.1.0",
  "description": "Headless, cycle-aware NES/Famicom emulator core for browsers and JavaScript runtimes.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Tangerg/fcemu/tree/master/packages/fc-emu#readme",
  "bugs": {
    "url": "https://github.com/Tangerg/fcemu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tangerg/fcemu.git",
    "directory": "packages/fc-emu"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark": "yarn build && node benchmarks/frame-buffer.mjs && node benchmarks/emulator-frame.mjs && node benchmarks/save-state.mjs",
    "catalog:roms": "yarn build && node scripts/catalog-roms.mjs",
    "fetch:test-roms": "node scripts/fetch-test-roms.mjs",
    "smoke:real-rom": "yarn build && node scripts/run-real-rom-smoke.mjs",
    "conformance:rom": "yarn build && node scripts/run-blargg-rom.mjs",
    "conformance:fixtures": "yarn fetch:test-roms && yarn build && node scripts/run-fixture-conformance.mjs",
    "conformance:nestest": "yarn build && node scripts/run-nestest.mjs",
    "conformance:cpu-timing": "yarn build && node scripts/run-cpu-timing-test.mjs",
    "conformance:accuracy-coin": "yarn build && node scripts/run-accuracy-coin.mjs",
    "conformance:cpu": "yarn conformance:rom",
    "conformance:mmc1": "yarn build && node scripts/run-holy-mapperel.mjs",
    "conformance:mapper34": "yarn build && node scripts/run-holy-mapper34.mjs",
    "conformance:oam-bus": "yarn build && node scripts/run-read2004.mjs",
    "conformance:pal-apu": "yarn build && node scripts/run-pal-apu.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
